{
  "name": "bgit-cli",
  "version": "3.0.0",
  "description": "Bitcoin-enabled Git wrapper - timestamp commits with HandCash, and publish whole repositories to BitcoinSV so they can be cloned back with stock git",
  "main": "index.js",
  "bin": {
    "bgit": "./index.js"
  },
  "preferGlobal": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node --test lib/chain/bgit-vectors.test.mjs",
    "verify-vendor": "node index.js chain verify-vendor",
    "start": "node index.js"
  },
  "keywords": [
    "bitcoin",
    "git",
    "bsv",
    "bitcoinsv",
    "handcash",
    "blockchain",
    "timestamp",
    "commit",
    "version-control",
    "archival",
    "censorship-resistance",
    "git-bundle"
  ],
  "author": "b0ase",
  "contributors": [
    "Ryan Bennett <https://github.com/zcoolz> (on-chain repository format: publisher, reader, claim, spec and test vectors — vendored unmodified from github.com/zcoolz/bgit under MIT)"
  ],
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@bsv/sdk": "^2.4.1",
    "@handcash/handcash-connect": "^0.8.11",
    "chalk": "^4.1.2",
    "express": "^4.18.2",
    "open": "^8.4.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bitcoin-apps-suite/bgit.git"
  },
  "bugs": {
    "url": "https://github.com/bitcoin-apps-suite/bgit/issues"
  },
  "homepage": "https://github.com/bitcoin-apps-suite/bgit#readme",
  "files": [
    "index.js",
    "handcash.js",
    "lib/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ]
}