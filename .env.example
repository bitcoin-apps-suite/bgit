# bgit environment template
#
# Copy to .env.local (gitignored) and fill in. NEVER commit real values.
#   cp .env.example .env.local

# ---------------------------------------------------------------------------
# HandCash — required for `bgit commit` and `bgit push` (pay-to-operate)
# ---------------------------------------------------------------------------

# App secret from https://dashboard.handcash.io/
# The matching APP ID is a public identifier and is compiled in (lib/constants.js).
# A previous secret was leaked to the public repo and rotated — keep this OUT of
# source, defaults, and any committed file.
HANDCASH_APP_SECRET=

# Optional: override the compiled-in public app id.
# HANDCASH_APP_ID=

# ---------------------------------------------------------------------------
# Publishing key — required for `bgit publish` and `bgit claim`
# ---------------------------------------------------------------------------

# A BSV private key in WIF format. This is NOT your HandCash wallet: publishing
# signs raw data-carrying transactions, which a custodial wallet cannot do.
#
# Generate one with:  bgit chain keygen
#
# Anyone holding this key controls the repository identity and its funds.
BSV_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Third broadcast fallback. TAAL ARC answers 401 to unauthenticated requests,
# so it is skipped entirely unless a key is present. WhatsOnChain and
# GorillaPool need no configuration.
# TAAL_API_KEY=

# Override where the vendored on-chain modules resolve @bsv/sdk from.
# Only needed in unusual install layouts; lib/chain-bridge.js sets a sane default.
# BGIT_SDK_DIR=
